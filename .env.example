# Copy to backend/.env and fill in. Never commit the real .env.

# --- Anthropic (required: powers clip selection) -----------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional override (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# --- TikTok Content Posting API (optional: Direct Post) ----------------
# Register an app at https://developers.tiktok.com (see README walkthrough)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/callback

# --- Transcription ------------------------------------------------------
# tiny | base | small | medium | large-v3  (bigger = better + slower)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto

# --- Storage ------------------------------------------------------------
# Where videos, clips and caches live (defaults to ./data next to backend/)
# DATA_DIR=/path/to/clipforge-data
